<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ArcBox</AssemblyName>
    <RootNamespace>ArcBox</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>ArcBox</Product>
    <Company>ArcBox</Company>
    <AssemblyTitle>ArcBox 압축 프로그램</AssemblyTitle>
    <Copyright>ArcBox. 7-Zip engine (c) Igor Pavlov, GNU LGPL</Copyright>
    <SatelliteResourceLanguages>ko</SatelliteResourceLanguages>
    <GenerateResourceUsePreserializedResources>false</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net48'">
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.CSharp" />
    <PackageReference Include="BrotliSharpLib" Version="0.3.3" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\engine\7z.dll" CopyToOutputDirectory="PreserveNewest" Link="7z.dll" />
    <None Include="..\..\engine\7-Zip-License.txt" CopyToOutputDirectory="PreserveNewest" Link="7-Zip-License.txt" />
    <None Include="..\..\engine\THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" Link="THIRD-PARTY-NOTICES.txt" />
    <None Include="..\..\engine\COPYING.txt" CopyToOutputDirectory="PreserveNewest" Link="COPYING.txt" />
    <None Include="..\..\assets\icons\*.ico" CopyToOutputDirectory="PreserveNewest" LinkBase="icons" />
  </ItemGroup>
</Project>
